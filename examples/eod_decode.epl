# eod_decode.epl — the ESP On Demand band decoder, written in ESPlab's
# task language (compile with: python3 tools/espc.py eod_decode.epl).
#
# This is the SAME algorithm as examples/eod_decode.s (the hand-written
# assembly that ships with the player) — kept side by side so you can see
# what the compiler produces and pick which style you prefer. The compiled
# version runs the same or fewer VM instructions than the hand-tuned
# assembly on real footage (enforced by tools/test_espc.py in CI).
#
# Input layout: 16-byte header, then RLE pairs (count, palette-index).
# The pixel cursor is absolute from 0: runs can straddle band edges.
# The visible part of a run is [max(lo,cur), min(cur+run,hi)) — negative
# when the run misses the band entirely, which is fine: emitn emits
# nothing when its count is zero or negative.

var cur = 0          # absolute pixel cursor
var p = 16           # pair cursor into the input

while (cur < hi) {
  cnt = input[p]
  p = p + 1
  idx = input[p]
  p = p + 1
  run = (cnt >> 1) + 1
  vis = min(cur + run, hi) - max(lo, cur)
  emitn idx, vis
  cur = cur + run
}
halt
